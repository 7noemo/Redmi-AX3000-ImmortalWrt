#
# Redmi AX3000 (RA81) - ImmortalWrt master / 25.12
#
# Target
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y

# Image: NAND + UBI (kernel lives in UBI volume 0, rootfs in volume 1)
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBIFS=y

# --- Chinese UI ----------------------------------------------------------
# luci-i18n-* are HIDDEN packages: they can only be pulled in through the
# LuCI language switch, listing them directly silently does nothing.
CONFIG_LUCI_LANG_zh_Hans=y

# --- LuCI core + apps ----------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- Network quality of life --------------------------------------------
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_mtr-nojson=y

# --- Storage / files -----------------------------------------------------
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# --- Wi-Fi ---------------------------------------------------------------
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_wpad-openssl=y
