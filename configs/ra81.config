#
# 红米 AX3000 / Redmi AX3000 (RA81) — ImmortalWrt master / openwrt-25.12
#
# 本文件是「种子」配置：只写必须显式指定的项，其余交给 make defconfig。
#
# ---- 显示型号是怎么一路传到 LuCI 的（改名字时四处一起改）-------------
#   ra81-support/dts 的 model        -> /tmp/sysinfo/model -> LuCI 概览「型号」
#   ra81-support 注入的 DEVICE_*     -> profiles.json 标题 / 镜像文件名前缀
#   files/etc/uci-defaults/99-ra81-identity -> 默认主机名
#   .github/workflows/build.yml      -> Actions 产物名 / Release 标题
# 当前值：型号 Redmi AX3000 (RA81)，镜像前缀 ImmortalWrt-Redmi-AX3000
#
# ---- 空间预算（硬墙 36 MiB）------------------------------------------
# rootfs / rootfs_1 各 0x02400000 = 36 MiB，内核 + squashfs 都要塞进这一格，
# 剩下的才是 /overlay。所以下面每一项都按「体积 / 收益」筛过，加东西前先
# 想清楚 36 MiB。
#

# --- Target -------------------------------------------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y

# --- Image: NAND + UBI (kernel 在 UBI vol 0，rootfs 在 vol 1) -----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBIFS=y

# --- 中文界面 -----------------------------------------------------------
# luci-i18n-* 是 HIDDEN 包，只有在语言开关里选才会被拉进来，
# 直接在下面列 luci-i18n-xxx-zh-cn 是无效的。
CONFIG_LUCI_LANG_zh_Hans=y

# --- LuCI 核心 + 应用 ---------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- 网络质量 -----------------------------------------------------------
CONFIG_PACKAGE_kmod-tcp-bbr=y
# kmod-sched 才带 sch_fq（kmod-sched-core 里没有）：缺了它
# net.core.default_qdisc=fq 会静默失败，BBR 实际跑在 pfifo_fast 上
CONFIG_PACKAGE_kmod-sched=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_mtr-nojson=y

# --- 存储 / 文件 --------------------------------------------------------
# RA81 没有 USB 口，存储栈（usb-storage / ext4 / exfat / block-mount /
# automount）全部去掉，省下约 1.5 MiB 给代理和中文界面。
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-storage-uas is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-exfat is not set
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# --- Wi-Fi --------------------------------------------------------------
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_wpad-openssl=y

# =======================================================================
# 翻墙：PassWall 2 + 单 Xray 芯核（约 13 MiB）
#
# 只装 LuCI 前端这一个第三方包，芯核/规则库/依赖全部用 immortalwrt 自带
# feeds 里的同名包 —— 23.05 那版同时挂了 passwall_packages feed，结果
# xray-core / v2ray-geodata 出现两份同名包，装到一半直接 255 退出。
#
# 体积控制的三个开关：
#   1. 只选 Xray（arm64 上默认会再拉 sing-box + haproxy + ss-rust + ssr +
#      v2ray-plugin + simple-obfs，那套组合 ~18 MiB，36 MiB 里装不下）
#   2. 不用 geoview（Go 写的，~5 MiB，运行时可选；CI 里会把它从依赖里摘掉）
#   3. geoip 换成 MetaCubeX 的 lite 版（15.7 MiB -> 0.2 MiB，CI 里改）
# =======================================================================
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# firewall4 环境走 nftables 透明代理，不引入 iptables
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y
# geoview：可选组件，默认不装（CI 会从 passwall2 的硬依赖里摘掉）
# CONFIG_PACKAGE_geoview is not set
